{
  config,
  pkgs,
  lib,
  ...
}:

{
  nixpkgs.overlays = [
    (final: prev: {
      imgbrd-grabber = final.stdenv.mkDerivation (finalAttrs: {
        pname = "imgbrd-grabber";
        version = "7.14.0-unstable-2025-05-09";

        src = prev.fetchFromGitHub {
          owner = "Bionus";
          repo = "imgbrd-grabber";
          rev = "56f673c6e821567e5a8af5361bf8004c62a55052";
          hash = "sha256-mEVpVH896SC9Jn5DhG6SHQ5e/XBXaTO02Pas2pISUao=";
          fetchSubmodules = true;
        };

        buildInputs =
          with prev.qt6;
          [
            qtbase
            qtdeclarative
            qttools
            qtnetworkauth
            qtmultimedia
          ]
          ++ [
            prev.openssl
            prev.libpulseaudio
          ];

        nativeBuildInputs = [
          prev.cmake
          prev.qt6.wrapQtAppsHook
          prev.typescript
        ];

        patches = [
          ./cmake4-compat.patch
        ];

        postPatch = ''
          # Modern TypeScript removed target: es5, update to es2015
          substituteInPlace sites/tsconfig.json --replace-fail '"target": "es5"' '"target": "es2015"'

          # CMake invokes npm to build sites; replace with tsc directly
          substituteInPlace sites/CMakeLists.txt \
            --replace-fail "npm install" "true" \
            --replace-fail "npm run build" "tsc -p tsconfig.json"

          # Support 'export const' generated by modern TypeScript (in addition to 'export var')
          substituteInPlace lib/src/models/javascript-source-engine.cpp \
            --replace-fail 'js.readAll().replace("export var source = ", "return ")' \
                           'js.readAll().replace("export var source = ", "return ").replace("export const source = ", "return ")'
          substituteInPlace lib/src/models/url-downloader/url-downloader-manager.cpp \
            --replace-fail 'f.readAll().replace("export var downloader = ", "return ")' \
                           'f.readAll().replace("export var downloader = ", "return ").replace("export const downloader = ", "return ")'
        '';

        sourceRoot = "${finalAttrs.src.name}/src";

        meta = {
          description = "Very customizable imageboard/booru downloader with powerful filenaming features";
          license = prev.lib.licenses.asl20;
          homepage = "https://bionus.github.io/imgbrd-grabber/";
          mainProgram = "Grabber";
          maintainers = with prev.lib.maintainers; [
            evanjs
            luftmensch-luftmensch
          ];
        };
      });
    })
  ];
}
